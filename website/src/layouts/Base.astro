---
import { sitePath } from "../data";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data";
import "../../assets/css/main.css";
interface Props {
  title: string;
  description?: string;
  image?: string;
  mathjax?: boolean;
}
const {
  title,
  description = site.description,
  image = "/images/je-social.jpg",
  mathjax,
} = Astro.props;
const pageTitle =
  Astro.url.pathname === sitePath("/")
    ? site.title
    : `${title} · ${site.title}`;
const canonical = new URL(
  Astro.url.pathname === sitePath("/404/")
    ? sitePath("/404.html")
    : Astro.url.pathname,
  Astro.site,
);
const ogImage = new URL(sitePath(image), Astro.site);
---

<!doctype html>
<html lang={Astro.url.pathname === sitePath("/") ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={sitePath("/je-icon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={sitePath("/site.webmanifest")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      href={sitePath("/index.xml")}
      title={site.title}
    />
    <meta
      property="og:type"
      content={Astro.url.pathname === sitePath("/") ? "website" : "article"}
    />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      mathjax && (
        <>
          <script
            is:inline
            set:html={
              'window.MathJax = { tex: { inlineMath: [["\\\\(", "\\\\)"]], displayMath: [["\\\\[", "\\\\]"]], processEscapes: true, processEnvironments: true } };'
            }
          />
          <script
            is:inline
            src="https://unpkg.com/mathjax@3/es5/tex-mml-chtml.js"
          />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar />
    <main id="main-content" data-pagefind-body><slot /></main>
    <Footer />
    <script>
      import "../../assets/js/nav-toggle.js";
    </script>
    <script>
      import "../../assets/js/copy-code.js";
    </script>
  </body>
</html>
