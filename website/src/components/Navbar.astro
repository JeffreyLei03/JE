---
import { site, sitePath } from "../data";
---

<nav class="site-nav shell" data-pagefind-ignore aria-label="Main navigation">
  <a class="brand" href={sitePath("/")} aria-label="JE home"
    >JE<span>/</span><small>BY JEFFREY</small></a
  >
  <button
    class="nav-toggle"
    id="navToggle"
    type="button"
    aria-expanded="false"
    aria-controls="navlinks"
    aria-label="Toggle menu"><span></span><span></span></button
  >
  <div class="navlinks" id="navlinks">
    <a href={`${sitePath("/")}#demo`}>演示</a><a
      href={`${sitePath("/")}#engineering`}>工程设计</a
    ><a href={sitePath("/quickstart/")}>文档</a>
    <button
      class="search-trigger"
      id="searchTrigger"
      type="button"
      aria-label="Search docs">搜索 <kbd>Ctrl K</kbd></button
    >
    <a class="nav-source" href={site.githubUrl}
      >GitHub <span aria-hidden="true">↗</span></a
    >
  </div>
</nav>
<dialog
  class="search-modal"
  id="searchModal"
  data-pagefind-ignore
  role="dialog"
  aria-modal="true"
  aria-label="Search documentation"
>
  <div class="search-modal-inner">
    <button
      class="search-close"
      id="searchClose"
      type="button"
      aria-label="Close search">关闭 ×</button
    ><div id="search"></div>
  </div>
</dialog>
<link href={sitePath("/pagefind/pagefind-ui.css")} rel="stylesheet" />
<script is:inline src={sitePath("/pagefind/pagefind-ui.js")}></script>
