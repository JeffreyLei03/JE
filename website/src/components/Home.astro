---
import { site, sitePath, version } from "../data";
import capture from "../../static/images/demo/capture.json";
import DesktopShowcase from "./DesktopShowcase.astro";
const frames = [
  {
    file: "01-prompt.jpg",
    label: "01 / 输入任务",
    title: "从一个明确的任务开始。",
    text: "读取 greeting.py，修改问候函数，添加两条测试，并用工具重新读取结果。",
    alt: "JE 实际 TUI：已输入修改函数和编写测试的任务",
  },
  {
    file: "02-result.jpg",
    label: "02 / 执行结果",
    title: "工具执行，结果可见。",
    text: "真实模型完成 read → edit → write → read → read。生成文件的两条断言均已通过。",
    alt: "JE 实际 TUI：DeepSeek 完成文件读取、编辑和测试文件写入",
  },
  {
    file: "03-tools.jpg",
    label: "03 / 展开详情",
    title: "把每一步展开检查。",
    text: "通过 Ctrl+O 展开工具输出，查看文件内容与修改差异。每次调用都留在会话中。",
    alt: "JE 实际 TUI：展开后的工具输出和代码修改详情",
  },
];
---

<div class="portfolio" id="top">
  <section class="portfolio-hero shell" aria-labelledby="hero-title">
    <div class="hero-intro">
      <p class="eyebrow">
        <span class="status-dot"></span> JEFFREY / SELECTED PROJECT 001
      </p>
      <h1 id="hero-title">
        让编码 Agent<br />的每一步，<br /><span>清晰可见。</span>
      </h1>
      <p class="hero-description">
        JE 是一个面向本地项目的 AI 编码助手。<br
        />从模型流式响应到工具执行，把复杂的运行过程<br
          class="desktop-break"
        />变成可阅读、可追踪、可继续的工作流。
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#desktop"
          >查看真实运行 <span aria-hidden="true">↗</span></a
        >
        <a class="text-link" href={sitePath("/quickstart/")}
          >阅读文档 <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="hero-tags">
        <span>Python</span><span>Electron / React</span><span>Streaming AI</span
        >
      </div>
    </div>
    <div class="hero-object" aria-label="JE 项目与运行界面预览">
      <div class="object-label">
        <span>ONE ENGINE. TWO INTERFACES.</span><span>v{version}</span>
      </div>
      <div class="je-monogram" aria-hidden="true">JE<span>_</span></div>
      <a
        class="hero-capture hero-desktop-capture"
        href="#desktop"
        aria-label="查看 JE 桌面端真实任务录像"
      >
        <div class="capture-bar">
          <span><i></i><i></i><i></i></span><span>JE DESKTOP / REAL OUTPUT</span
          ><span>↗</span>
        </div>
        <img
          src={sitePath("/media/desktop/poster.jpg")}
          alt="JE 原生桌面端：真实模型生成赛博朋克 3D 霓虹公路交互应用"
          width="1480"
          height="960"
          fetchpriority="high"
        />
      </a>
      <div class="object-foot">
        <span>READ. THINK. ACT.</span><span>BUILT TO BE UNDERSTOOD.</span>
      </div>
    </div>
  </section>

  <div class="project-strip shell" aria-label="项目能力">
    <div><small>INTERFACE</small><span>桌面工作台 / 终端 / CLI</span></div>
    <div><small>RUNTIME</small><span>流式事件 / 工具调用</span></div>
    <div><small>CONTINUITY</small><span>本地会话 / 上下文恢复</span></div>
    <a href={site.githubUrl}
      >SOURCE AVAILABLE <span aria-hidden="true">↗</span></a
    >
  </div>

  <DesktopShowcase />

  <section class="demo-section" id="demo" aria-labelledby="demo-title">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">02 / THE TERMINAL EXPERIENCE</p><span
          class="section-note">REAL MODEL. REAL TOOLS. REAL OUTPUT.</span
        >
      </div>
      <div class="section-intro">
        <h2 id="demo-title">同一个引擎，终端也轻盈。</h2><p>
          一次真实的编码任务，三个可以检查的时刻。<br />截图来自 JE 的 Textual
          运行界面。
        </p>
      </div>
      <div class="demo-layout">
        <div class="demo-story">
          <div class="demo-controls" aria-label="选择运行截图">
            {
              frames.map((frame, index) => (
                <button
                  type="button"
                  class:list={["demo-step", { active: index === 1 }]}
                  aria-pressed={index === 1 ? "true" : "false"}
                  aria-controls="demo-image"
                  data-src={sitePath(`/images/demo/${frame.file}`)}
                  data-title={frame.title}
                  data-description={frame.text}
                  data-alt={frame.alt}
                >
                  {frame.label}
                  <span aria-hidden="true">↗</span>
                </button>
              ))
            }
          </div>
          <div class="demo-copy" aria-live="polite">
            <h3 id="demo-copy-title">{frames[1].title}</h3><p
              id="demo-copy-text"
            >
              {frames[1].text}
            </p>
          </div>
          <dl class="run-facts">
            <div><dt>MODEL</dt><dd>{capture.model}</dd></div><div>
              <dt>CAPTURE</dt><dd>{capture.captured_at} / 120 × 40</dd>
            </div><div>
              <dt>VALIDATION</dt><dd>
                <span class="status-dot"></span> 2 / 2 assertions passed
              </dd>
            </div>
          </dl>
          <a class="text-link" href={sitePath("/images/demo/capture.json")}
            >查看运行记录 <span aria-hidden="true">↗</span></a
          >
        </div>
        <figure class="demo-figure">
          <button
            class="screenshot-button"
            type="button"
            aria-label="放大当前运行截图"
            ><img
              id="demo-image"
              src={sitePath("/images/demo/02-result.jpg")}
              alt={frames[1].alt}
              width="1040"
              height="720"
              loading="lazy"
            /></button
          >
          <figcaption>
            <span><span class="status-dot"></span> REAL RUN / CAPTURE</span
            ><span>点击截图放大 ↗</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section
    class="engineering-section shell"
    id="engineering"
    aria-labelledby="engineering-title"
  >
    <div class="section-heading">
      <p class="eyebrow">03 / ENGINEERING UNDER THE SURFACE</p><span
        class="section-note">SMALL BOUNDARIES. CLEAR RESPONSIBILITIES.</span
      >
    </div>
    <div class="section-intro">
      <h2 id="engineering-title">
        界面之外，<br /><span class="muted">是清晰的边界。</span>
      </h2><p>
        模型协议、Agent 引擎与终端应用各司其职。<br
        />运行时传递事件，界面订阅并呈现结果。
      </p>
    </div>
    <div class="architecture" aria-label="JE 三层架构">
      <a class="architecture-layer" href={sitePath("/internals/architecture/")}
        ><span class="layer-number">01 / MODEL</span><h3>
          je_ai<span>↗</span>
        </h3><p>把不同模型提供商的响应，转换为统一的流式事件。</p><span
          class="layer-chip">Provider → typed events</span
        ></a
      >
      <a class="architecture-layer" href={sitePath("/internals/agent-loop/")}
        ><span class="layer-number">02 / ENGINE</span><h3>
          je_agent<span>↗</span>
        </h3><p>管理消息、调用工具、推进循环。核心引擎可以独立复用。</p><span
          class="layer-chip">Messages → tools → loop</span
        ></a
      >
      <a class="architecture-layer" href={sitePath("/guides/tui/")}
        ><span class="layer-number">03 / EXPERIENCE</span><h3>
          je_coding<span>↗</span>
        </h3><p>
          组装工程上下文与持久化会话，通过事件流服务终端和桌面界面。
        </p><span class="layer-chip">Context → session → UI</span></a
      >
    </div>
    <div class="engineering-notes">
      <article>
        <span class="note-number">A</span><h3>让进度及时呈现</h3><p>
          工具执行中的更新通过异步事件队列传递，终端能在任务结束前呈现进度；取消时清理后台任务。
        </p><a
          class="text-link"
          href={`${site.githubUrl}/blob/main/src/je_agent/loop.py`}
          >查看运行循环 ↗</a
        >
      </article>
      <article>
        <span class="note-number">B</span><h3>把平台差异处理好</h3><p>
          处理 Windows
          路径、文件拖入与更新进程启动，同时保持会话存储和项目信任机制的一致性。
        </p><a
          class="text-link"
          href={`${site.githubUrl}/blob/main/src/je_coding/tui/file_drop.py`}
          >查看文件交互 ↗</a
        >
      </article>
      <article>
        <span class="note-number">C</span><h3>用真实调用验证链路</h3><p>
          演示覆盖模型响应、文件读取与编辑、测试文件写入。通过展开工具结果，可以检查执行细节。
        </p><a class="text-link" href={sitePath("/images/demo/capture.json")}
          >查看演示证据 ↗</a
        >
      </article>
    </div>
  </section>

  <section
    class="explore-section shell"
    id="explore"
    aria-labelledby="explore-title"
  >
    <p class="eyebrow">04 / KEEP EXPLORING</p><h2 id="explore-title">
      从使用，到理解。
    </h2>
    <div class="explore-grid">
      <a href={sitePath("/quickstart/")}
        ><small>GET STARTED</small><h3>在你的终端运行 JE <span>↗</span></h3><p>
          安装、配置模型，开始第一个会话。
        </p></a
      ><a href={sitePath("/internals/architecture/")}
        ><small>READ THE SYSTEM</small><h3>深入架构与设计 <span>↗</span></h3><p>
          阅读分层设计、事件契约与 Agent 循环。
        </p></a
      >
    </div>
  </section>
</div>

<dialog class="screenshot-dialog" aria-label="JE 运行截图放大查看">
  <div class="dialog-toolbar">
    <span>JE / RUN CAPTURE</span><button
      type="button"
      class="dialog-close"
      aria-label="关闭截图">关闭 ×</button
    >
  </div><div class="dialog-image-viewport">
    <img id="enlarged-image" alt="" />
  </div><p>
    Textual 原生截图 · 可滚动查看细节 · Esc 关闭 <a
      id="original-image"
      href={sitePath("/images/demo/02-result.svg")}
      target="_blank"
      rel="noopener">原生 SVG ↗</a
    >
  </p>
</dialog>
<script>
  const image = document.querySelector<HTMLImageElement>("#demo-image");
  const dialog =
    document.querySelector<HTMLDialogElement>(".screenshot-dialog");
  const enlarged = document.querySelector<HTMLImageElement>("#enlarged-image");
  const steps = document.querySelectorAll<HTMLButtonElement>(".demo-step");
  steps.forEach((step) =>
    step.addEventListener("click", () => {
      if (!image) return;
      image.src = step.dataset.src ?? "";
      image.alt = step.dataset.alt ?? "";
      const title = document.querySelector("#demo-copy-title");
      const text = document.querySelector("#demo-copy-text");
      if (title) title.textContent = step.dataset.title ?? "";
      if (text) text.textContent = step.dataset.description ?? "";
      steps.forEach((other) => {
        other.classList.toggle("active", other === step);
        other.setAttribute("aria-pressed", String(other === step));
      });
    }),
  );
  document
    .querySelector(".screenshot-button")
    ?.addEventListener("click", () => {
      if (!dialog || !image || !enlarged) return;
      enlarged.src = image.src;
      enlarged.alt = image.alt;
      const original =
        document.querySelector<HTMLAnchorElement>("#original-image");
      if (original) original.href = image.src.replace(/\.jpg$/, ".svg");
      dialog.showModal();
      document.body.classList.add("screenshot-open");
    });
  document
    .querySelector(".dialog-close")
    ?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("close", () =>
    document.body.classList.remove("screenshot-open"),
  );
</script>
