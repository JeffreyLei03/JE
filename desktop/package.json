{
  "name": "je-desktop",
  "version": "0.1.0",
  "description": "JE local coding workspace with conversations, code and inspectable agent tools",
  "author": "Jeffrey",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "package": "npm run build && node scripts/build-engine.mjs && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.jeffrey.je",
    "productName": "JE Desktop",
    "compression": "normal",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "!node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine-dist/je-engine.exe",
        "to": "engine/je-engine.exe"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
